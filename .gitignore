node_modules/
dist/
.next/
.env
.env.local
*.log
cache/
artifacts/
typechain-types/

# generated signing keys — never commit
deploy/.keys.env
.keys.env

# create-pepu-app's build-time mirrors of ../../templates and ../sdk's
# dist — regenerated by scripts/sync-assets.mjs on every build, not
# source. Without this, a `pnpm build` run before a first commit would
# check in stale duplicates of templates/* and packages/sdk/dist.
packages/create-pepu-app/vendor/
packages/create-pepu-app/templates/

# publish-time-only copies (see RELEASING.md) — never
# committed, regenerated from the root LICENSE before each npm publish.
packages/*/LICENSE

# Foundry build output (regenerated by `forge build`)
**/out/
**/cache/
**/broadcast/
lib/forge-std/
**/lib/solmate/
**/lib/openzeppelin-contracts/

# service/run logs
*.log
services/**/data/

# Local agent worktrees
.claude/worktrees/

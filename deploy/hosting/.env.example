# Compose-level settings for deploy/hosting (copy to .env, never commit .env).
# Everything here is non-secret EXCEPT BUNDLER_SHARED_SECRET (optional).
# Real secrets (keys, RPC URL, Privy secret, admin token) live in ./secrets/*, not here.

# Public base domain. DNS A/AAAA records are required for BOTH of:
#   bundler.<DOMAIN>    and    paymaster.<DOMAIN>   -> this VM's public IP
DOMAIN=example.com

# Let's Encrypt account contact (expiry / problem notices).
ACME_EMAIL=ops@example.com

# Anchored regex of BROWSER origins allowed to call the endpoints (Go RE2 syntax).
# Keep the single quotes: the $ and \ must reach Caddy untouched. Requests with no
# Origin header (servers, curl) are not affected by this; see Caddyfile.
ALLOWED_ORIGIN_REGEX='^https://(app[.]example[.]com|dashboard[.]example[.]com)$'

# OPTIONAL shared secret for the bundler: if non-empty every non-preflight, non-/health
# request must carry the header  X-Pepu-Bundler-Key: <value>. Leave EMPTY for a public
# bundler that browsers and the SDK's hosted default call directly (they cannot hold it).
# Generate with:  openssl rand -hex 32
BUNDLER_SHARED_SECRET=

# Per-client-IP request budgets, requests per minute. Tune from the access logs.
# Receipt polling counts: a UserOp flow is roughly 10-20 bundler calls.
RATE_BUNDLER_EVENTS=300
RATE_PAYMASTER_EVENTS=120
RATE_SPONSOR_EVENTS=60

# Request body cap at the edge (the policy service also caps at 256 KiB).
MAX_BODY=256KB

# Host loopback port that exposes the policy service's /ready to the monitor on the VM only.
POLICY_LOOPBACK_PORT=18788

# Container memory ceilings (adjust to the VM; CX22 has 4 GB).
ALTO_MEM_LIMIT=1536m
POLICY_MEM_LIMIT=512m
CADDY_MEM_LIMIT=256m

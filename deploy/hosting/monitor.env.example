# Settings for scripts/healthcheck-alert.sh (copy to monitor.env, chmod 600, never commit:
# WEBHOOK_URL and HEARTBEAT_URL are secrets).
# Run from cron (see crontab.example) every 5 minutes. Exit code 1 = at least one check failed.

# --- What to probe -------------------------------------------------------------------------
PUBLIC_BUNDLER_URL=https://bundler.example.com
PUBLIC_PAYMASTER_URL=https://paymaster.example.com
# Same value as BUNDLER_SHARED_SECRET in .env, only if you enabled it.
BUNDLER_SHARED_SECRET=
# The policy service's readiness endpoint on the VM's loopback port (POLICY_LOOPBACK_PORT).
POLICY_READY_URL=http://127.0.0.1:18788/ready

# --- On-chain checks (independent of the services, straight to the chain RPC) --------------------
# The RPC URL secret file is mounted into the checker read-only; the URL is never printed.
RPC_URL_FILE=/run/secrets/rpc_url
EXPECTED_CHAIN_ID=97741
ENTRY_POINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
PAYMASTER_ADDRESS=0x2B6FED323bFA24f0475f4e1Dd3C7F6Cc1f3ae8B0
# Comma separated PUBLIC addresses of the executor key(s). Never a private key.
EXECUTOR_ADDRESSES=0xREPLACE_WITH_EXECUTOR_ADDRESS
# Alert when the paymaster's EntryPoint deposit is below LOW (needs top-up) or above HIGH
# (more money at risk than intended). Wei, decimal. Placeholders: 100 PEPU / 500 PEPU.
DEPOSIT_LOW_WEI=100000000000000000000
DEPOSIT_HIGH_WEI=500000000000000000000
# Alert when any executor balance is below this (wei). Placeholder: 100 PEPU.
EXECUTOR_MIN_WEI=100000000000000000000
# Alert when the TLS certificate of either public host expires in fewer days than this.
CERT_MIN_DAYS=14

# --- Alerting ----------------------------------------------------------------------------------
# Slack / Discord / any webhook that accepts a JSON POST. Leave empty to only print + exit code.
WEBHOOK_URL=
# slack | discord | generic   (slack => {"text":...}, discord => {"content":...}, generic => both + details)
WEBHOOK_FORMAT=slack
# Re-send an unresolved alert at most every N minutes (a change in the failing set sends at once).
ALERT_REPEAT_MINUTES=60
# Dead-man's switch: GET this URL after every run where all checks passed (healthchecks.io style).
# If cron or the VM dies, the external service alerts you. Leave empty to disable.
HEARTBEAT_URL=
# Where the dedupe state lives inside the checker container (a host dir is mounted at /state).
STATE_FILE=/state/alert-state.json
# Label that prefixes every alert.
ALERT_LABEL=pepu-hosting

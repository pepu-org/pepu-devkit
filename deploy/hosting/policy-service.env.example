# Non-secret configuration of the v1 policy service (copy to policy-service.env, never commit).
# SECRETS ARE NOT SET HERE. They are mounted as files from ./secrets and picked up through
# the *_FILE convention in docker-compose.yml:
#   PAYMASTER_SIGNER_PRIVATE_KEY_FILE, PRIVY_APP_SECRET_FILE, ADMIN_TOKEN_FILE, RPC_URL_FILE
# NODE_ENV=production, PORT, DB_PATH, APPS_CONFIG_PATH and ALLOWLIST_CONFIG_PATH are set by the
# compose file. In production deploy/.keys.env is never read, and PEPU_APPS_PROFILE=dev is refused.

# --- Identity of the on-chain paymaster and its signer --------------------------------------
# The deployed v1 contract (PepuVerifyingPaymasterV7).
PAYMASTER_CONTRACT_ADDRESS=0x2B6FED323bFA24f0475f4e1Dd3C7F6Cc1f3ae8B0

# REQUIRED in production. The address of the FRESH hosted signer key (printed by
# `gen-key`, see RUNBOOK "Keys and secrets"). The service refuses to start if the key file
# derives a different address. This address must also have been registered on-chain with
# addSigner(address) before go-live.
PAYMASTER_SIGNER_ADDRESS=0xREPLACE_WITH_ADDRESS_PRINTED_BY_GEN_KEY

# --- Privy -------------------------------------------------------------------------------
PRIVY_APP_ID=REPLACE_WITH_PRIVY_APP_ID

# --- Browser/CORS policy for /paymaster/<appToken> ------------------------------------------
# Exact Origin values (scheme://host[:port]), comma separated. Browser-only speed bump; the
# real controls are the app token, the caps, the rate limit and the deposit size.
PAYMASTER_RPC_ALLOWED_ORIGINS=https://app.example.com,https://dashboard.example.com
# Server-side callers (an app's API routes, scripts, `prove-session`) send no Origin header.
# true = accept them even though an allowlist is set. Browsers always send Origin, so a
# browser on another site is still refused.
PAYMASTER_RPC_ALLOW_MISSING_ORIGIN=true
PAYMASTER_RPC_ALLOW_ACCOUNT_DEPLOYMENT=true

# --- Spend limits: keep these SMALL and tune up with data -----------------------------------
# The deposit (see below) is the true worst-case loss if the signer key leaks, because the
# contract itself enforces no cap. These limits bound normal abuse, not a key compromise.
# Reference costs measured on mainnet: account deployment ~12 PEPU, later ops ~3 PEPU.
USER_HOURLY_COUNT_CAP=20
USER_DAILY_COUNT_CAP=100
USER_LIFETIME_COUNT_CAP=2000
USER_HOURLY_SPEND_CAP_WEI=25000000000000000000
USER_DAILY_SPEND_CAP_WEI=100000000000000000000
USER_LIFETIME_SPEND_CAP_WEI=1000000000000000000000
# GLOBAL circuit breaker: total worst-case sponsorship per UTC day across everyone. Set it
# at or below the deposit so one day of abuse cannot empty it. 100 PEPU is a placeholder.
GLOBAL_DAILY_SPEND_CEILING_WEI=100000000000000000000

# --- /ready thresholds (wei) -------------------------------------------------------------------
# Below the minimum the service reports NOT ready (sponsorship would fail on-chain anyway).
# Above the maximum it reports a WARNING: the deposit is bigger than the blast radius you chose.
READY_MIN_DEPOSIT_WEI=50000000000000000000
READY_MAX_DEPOSIT_WEI=500000000000000000000

# --- Executed-marker reconciler -------------------------------------------------------------
# Reads the EntryPoint's UserOperationEvent logs for this paymaster and marks approvals
# executed so caps do not under-count after valid_until. Needs RPC_URL (set via RPC_URL_FILE).
RECONCILER_ENABLED=true
RECONCILER_INTERVAL_MS=30000
# eth_getLogs window; lower it if the RPC provider rejects wide ranges.
RECONCILER_CHUNK_BLOCKS=2000
# First run only: how far back to look. Set RECONCILER_START_BLOCK to the paymaster's
# deployment block to backfill everything instead.
RECONCILER_LOOKBACK_BLOCKS=100000
RECONCILER_CONFIRMATIONS=2

# --- Operator CLI thresholds (used by `monitor-deposit`, run from the owner's machine) --------
DEPOSIT_LOW_WATER_MARK_WEI=100000000000000000000
DEPOSIT_TOP_UP_TARGET_WEI=250000000000000000000
DEPOSIT_MAX_CEILING_WEI=400000000000000000000

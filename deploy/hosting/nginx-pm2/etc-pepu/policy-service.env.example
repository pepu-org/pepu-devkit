# /etc/pepu/policy-service.env   (install.sh creates it from this file; mode 640 root:pepu; never commit the real one)
#
# Non-secret configuration of the v1 policy service under pm2, loaded with Node's `--env-file` (see
# ecosystem.config.cjs). Format: KEY=value, one per line, no `export`, no shell expansion.
#
# NOT set here (and not to be): the SECRETS, which are files under /etc/pepu/secrets named by *_FILE variables in
# ecosystem.config.cjs (PAYMASTER_SIGNER_PRIVATE_KEY_FILE, PRIVY_APP_SECRET_FILE, ADMIN_TOKEN_FILE, RPC_URL_FILE).
# Also fixed by ecosystem.config.cjs, which wins over this file: NODE_ENV=production, PORT=8788, DB_PATH,
# APPS_CONFIG_PATH, ALLOWLIST_CONFIG_PATH, TRUST_PROXY=true, TRUSTED_PROXY_HOPS=1, SHUTDOWN_TIMEOUT_MS=10000.
# In production the service refuses PEPU_APPS_PROFILE=dev and never reads deploy/.keys.env.

# --- Identity of the on-chain paymaster and its signer --------------------------------------
# The deployed v1 contract (PepuVerifyingPaymasterV7).
PAYMASTER_CONTRACT_ADDRESS=0x2B6FED323bFA24f0475f4e1Dd3C7F6Cc1f3ae8B0

# REQUIRED in production. The address printed by gen-key for the FRESH hosted signer key (RUNBOOK section 5). The
# service refuses to start if the key file derives a different address. It must be registered on-chain with
# addSigner(address) before go-live.
PAYMASTER_SIGNER_ADDRESS=0xREPLACE_WITH_ADDRESS_PRINTED_BY_GEN_KEY

# --- Privy -------------------------------------------------------------------------------
PRIVY_APP_ID=REPLACE_WITH_PRIVY_APP_ID

# --- Browser/CORS policy for /paymaster/<appToken> ------------------------------------------
# Exact Origin values (scheme://host[:port]), comma separated. Browser-only speed bump; the real controls are the app
# token, the caps, the rate limit and the deposit size. Keep in sync with nginx conf.d/pepu-origins.conf.
# DECISION (owner): the real frontend origins.
PAYMASTER_RPC_ALLOWED_ORIGINS=https://pepeunchained.com,https://www.pepeunchained.com,https://guide.pepeunchained.com
# Server-side callers (an app's API routes, scripts, `prove-session`) send no Origin header. true = accept them even
# though an allowlist is set. Browsers always send Origin, so a browser on another site is still refused.
PAYMASTER_RPC_ALLOW_MISSING_ORIGIN=true
PAYMASTER_RPC_ALLOW_ACCOUNT_DEPLOYMENT=true

# --- Spend limits: keep these SMALL and tune up with data -----------------------------------
# The deposit is the true worst-case loss if the signer key leaks, because the contract itself enforces no cap. These
# limits bound normal abuse, not a key compromise. Measured on mainnet: account deployment ~12 PEPU, later ops ~3 PEPU.
USER_HOURLY_COUNT_CAP=20
USER_DAILY_COUNT_CAP=100
USER_LIFETIME_COUNT_CAP=2000
USER_HOURLY_SPEND_CAP_WEI=25000000000000000000
USER_DAILY_SPEND_CAP_WEI=100000000000000000000
USER_LIFETIME_SPEND_CAP_WEI=1000000000000000000000
# GLOBAL circuit breaker: total worst-case sponsorship per UTC day across everyone. Set it at or below the deposit so
# one day of abuse cannot empty it. DECISION (owner). 100 PEPU/day is a placeholder.
GLOBAL_DAILY_SPEND_CEILING_WEI=100000000000000000000

# --- /ready thresholds (wei) -------------------------------------------------------------------
# Below the minimum the service reports NOT ready. Above the maximum it only warns (deposit bigger than the blast
# radius you chose). With the current v1 deposit of about 1,943 PEPU, /ready warns until you reduce it (RUNBOOK 5.4).
READY_MIN_DEPOSIT_WEI=50000000000000000000
READY_MAX_DEPOSIT_WEI=500000000000000000000

# --- Executed-marker reconciler -------------------------------------------------------------
# Reads the EntryPoint's UserOperationEvent logs for this paymaster and marks approvals executed so caps do not
# under-count after valid_until. Needs the RPC URL (RPC_URL_FILE in ecosystem.config.cjs).
RECONCILER_ENABLED=true
RECONCILER_INTERVAL_MS=30000
# eth_getLogs window; lower it if the RPC provider rejects wide ranges.
RECONCILER_CHUNK_BLOCKS=2000
# First run only: how far back to look. Set RECONCILER_START_BLOCK to the paymaster's deployment block to backfill
# everything instead.
RECONCILER_LOOKBACK_BLOCKS=100000
RECONCILER_CONFIRMATIONS=2

# /etc/pepu/monitor.env   (install.sh creates it from this file; mode 640 root:pepu; never commit the real one)
# Settings for scripts/healthcheck-cron.sh -> deploy/hosting/scripts/healthcheck-alert.mjs, run from the pepu user's
# cron every 5 minutes (crontab.example). Loaded with Node's --env-file: KEY=value, no quotes needed, no `export`.
# WEBHOOK_URL, HEARTBEAT_URL and BUNDLER_SHARED_SECRET are secrets. Exit code 1 = at least one check failed.

# --- What to probe -------------------------------------------------------------------------
PUBLIC_BUNDLER_URL=https://bundler.pepeunchained.com
PUBLIC_PAYMASTER_URL=https://paymaster.pepeunchained.com
# Same value as in nginx conf.d/pepu-bundler-key.conf, only if you enabled the shared secret.
BUNDLER_SHARED_SECRET=
# The policy service's readiness endpoint, straight to the loopback port (does not go through nginx).
POLICY_READY_URL=http://127.0.0.1:8788/ready

# --- On-chain checks (independent of the services, straight to the chain RPC) --------------------
RPC_URL_FILE=/etc/pepu/secrets/rpc_url
EXPECTED_CHAIN_ID=97741
ENTRY_POINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
PAYMASTER_ADDRESS=0x2B6FED323bFA24f0475f4e1Dd3C7F6Cc1f3ae8B0
# Comma separated PUBLIC addresses of the executor key(s). Never a private key.
EXECUTOR_ADDRESSES=0xREPLACE_WITH_EXECUTOR_ADDRESS
# Alert when the paymaster's EntryPoint deposit is below LOW (needs top-up) or above HIGH (more money at risk than
# intended). Wei, decimal. DECISION (owner); placeholders: 100 PEPU / 500 PEPU.
DEPOSIT_LOW_WEI=100000000000000000000
DEPOSIT_HIGH_WEI=500000000000000000000
# Alert when any executor balance is below this (wei). DECISION (owner); placeholder: 100 PEPU.
EXECUTOR_MIN_WEI=100000000000000000000
# Alert when the TLS certificate of either public host expires in fewer days than this.
CERT_MIN_DAYS=14

# --- Alerting ----------------------------------------------------------------------------------
# Slack / Discord / any webhook that accepts a JSON POST. DECISION (owner). Empty = only print + exit code.
WEBHOOK_URL=
# slack | discord | generic
WEBHOOK_FORMAT=slack
# Re-send an unresolved alert at most every N minutes (a change in the failing set sends at once).
ALERT_REPEAT_MINUTES=60
# Dead-man's switch: GET this URL after every run where all checks passed (healthchecks.io style). If cron or the VM
# dies, the external service alerts you. DECISION (owner). Empty = disabled.
HEARTBEAT_URL=
# Dedupe state (owned by the pepu user).
STATE_FILE=/var/lib/pepu/monitor/alert-state.json
ALERT_LABEL=pepu-hosting

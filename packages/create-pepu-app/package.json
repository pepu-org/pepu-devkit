{
  "name": "create-pepu-app",
  "version": "0.1.3",
  "description": "Scaffold a PEPU devkit starter template — consumer app, token-gated app, NFT mint, game, gas-sponsored demo, or sponsored session app — for Pepe Unchained V2.",
  "license": "MIT",
  "author": "Pepe Unchained <contact@pepeunchained.com> (https://pepeunchained.com)",
  "homepage": "https://guide.pepeunchained.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepu-org/pepu-devkit.git",
    "directory": "packages/create-pepu-app"
  },
  "bugs": {
    "url": "https://github.com/pepu-org/pepu-devkit/issues"
  },
  "type": "module",
  "bin": {
    "create-pepu-app": "./dist/index.js"
  },
  "files": [
    "LICENSE",
    "dist",
    "templates",
    "vendor"
  ],
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "build": "node scripts/sync-assets.mjs && tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/sync-assets.mjs",
    "test": "vitest run",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "devDependencies": {
    "@pepu-chain/sdk": "workspace:*",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "pepu",
    "pepe-unchained",
    "create-pepu-app",
    "scaffold",
    "starter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  }
}

      "types": "./dist/aa/react.d.ts",
      "node": {
        "import": "./dist/aa/react.guard.js"
      },
      "import": "./dist/aa/react.js",
      "require": "./dist/aa/react.cjs"
    },
    "./aa/react-direct": {
      "types": "./dist/aa/react-direct.d.ts",

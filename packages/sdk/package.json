{
  "name": "@pepu-chain/sdk",
  "version": "0.2.4",
  "description": "Chain definitions, contract registry, token list, and viem helpers for Pepe Unchained V2.",
  "license": "MIT",
  "author": "Pepe Unchained <contact@pepeunchained.com> (https://pepeunchained.com)",
  "homepage": "https://docs.pepeunchained.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepu-org/pepu-devkit.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/pepu-org/pepu-devkit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

        "import": "./dist/react.guard.js"
      },
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./privy": {
      "types": "./dist/privy.d.ts",
      "import": "./dist/privy.js",
      "require": "./dist/privy.cjs"
    },
    "./privy/react": {
      "types": "./dist/privy/react.d.ts",
      "node": {
        "import": "./dist/privy/react.guard.js"
      },
      "import": "./dist/privy/react.js",
      "require": "./dist/privy/react.cjs"
    },
    "./privy/wagmi": {
      "types": "./dist/privy/wagmi.d.ts",
      "node": {
        "import": "./dist/privy/wagmi.guard.js"
      },
      "import": "./dist/privy/wagmi.js"
    },

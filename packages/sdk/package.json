  "files": [
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/prune-esm-only.mjs && node scripts/guard-peers.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "live-check": "node scripts/live-check.mjs",
    "prove-session": "node scripts/prove-session.mjs",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "peerDependencies": {
    "viem": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "@privy-io/react-auth": "^3.44.0",
    "@privy-io/node": "^0.34.0",
    "@privy-io/wagmi": "^4.0.0",
    "wagmi": "^3.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@zerodev/sdk": "^5.5.0",
    "@zerodev/permissions": "^5.6.0",
    "@zerodev/ecdsa-validator": "^5.4.0",

# =====================================================================
# PEPU game template — session signers
# Copy to .env.local and fill in. The app renders a setup screen listing
# whatever is still missing, so you can start with none of these set.
# =====================================================================

# --- Privy app (required) --------------------------------------------
#
#   1. https://dashboard.privy.io -> sign up / log in
#   2. Create an app
#   3. Settings -> copy the "App ID" (looks like "clabcd1234efgh5678ijkl")
#
# Public by design: the NEXT_PUBLIC_ prefix bundles it into client JS.
# That is how Privy is meant to be used. Never put a secret here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy app secret. SERVER ONLY — no NEXT_PUBLIC_ prefix, never sent to
# the browser. Dashboard -> Settings -> App secret.
# This authenticates the backend that submits gameplay transactions, AND
# (createEnsureWalletRoute, app/api/wallet/ensure) the backend that
# provisions a player's embedded wallet right after login — required
# because `createOnLogin` is inert whenever the Dashboard has automatic
# wallet creation off.
PRIVY_APP_SECRET=

# --- Privy dashboard checklist (settings live in your Privy app, not here) --
#
# Where each value comes from: https://dashboard.privy.io -> your app ->
# Settings (Basics). NEXT_PUBLIC_PRIVY_APP_ID is PUBLIC (bundled into client
# JS). PRIVY_APP_SECRET is SECRET and server-only; never prefix it NEXT_PUBLIC_.
#
# [ ] Allowed origins (Configuration -> App settings): add the exact origin
#     with the port, http://localhost:3000, plus your production domain
#     (https://your-domain). http://localhost without the port does not match,
#     and Next.js silently moves to 3001 if 3000 is busy; free the port.
# [ ] Login methods (User management -> Authentication): email, Google, external wallet (matches loginMethods in
#     app/providers.tsx: email, google, wallet). Enable what you list.
#     Methods not enabled in the dashboard are hidden even if listed in code.
# [ ] Embedded wallets (Wallets): enable for Ethereum, create on login.
#     Coinbase Wallet is pinned to eoaOnly in code; nothing to do here.
#     WalletGate calls /api/wallet/ensure after login, which creates the wallet
#     server-side with PRIVY_APP_SECRET if the dashboard setting is off, so
#     both together is fine. TEE / user-controlled mode is what the live tests
#     used; the legacy device mode also works.
# [ ] Smart wallets: NOT needed, leave off. This template uses a session
#     signer on a plain embedded wallet.
# [ ] Authorization key + key quorum (Wallet infrastructure -> Authorization
#     keys): run `npm run generate-authorization-key`, register the PUBLIC key
#     as a new authorization key, put it in a key quorum, and copy the quorum
#     id into NEXT_PUBLIC_PRIVY_KEY_QUORUM_ID (public identifier). The PRIVATE
#     key goes in PRIVY_AUTHORIZATION_KEY (SECRET, server-only). The quorum id
#     and the private key must come from the same pair, or Privy answers 401
#     "No valid authorization keys...". Policies are created per grant by the
#     SDK; policy and rule names must be at most 49 characters.
#
# Verify any time: npm run doctor (or the pepu_check_privy_config MCP tool).


# --- Session signer authorization key (required) ---------------------
#
# Session signers are authorized by a P-256 key pair you register with
# Privy. The server signs each eth_signTransaction request with the
# private half; Privy checks it, then evaluates the attached policy.
#
# Generate a pair:
#
#   npm run generate-authorization-key
#
# Register the PUBLIC half in the Privy Dashboard (Authorization keys /
# key quorums), then put the two resulting values below.

# The key quorum ID Privy gives you after registering the public key.
# An identifier, not a secret — Privy's own client-side addSigners()
# examples pass it from browser code, so NEXT_PUBLIC_ is correct here.
NEXT_PUBLIC_PRIVY_KEY_QUORUM_ID=

# The PRIVATE half, base64 PKCS8, no PEM headers — exactly what
# generate-authorization-key prints.
#
# THIS IS A REAL SECRET. Anyone holding it can request transactions as
# any wallet that granted a signer to this quorum. Those requests are
# still bounded by the attached policy (contract + function + zero value
# + expiry), but treat this like a production signing key: never commit
# it, never expose it client-side, rotate it if it leaks.
PRIVY_AUTHORIZATION_KEY=


# --- Game contract (required) ----------------------------------------
#
# Deploy contracts/foundry (or contracts/hardhat) and paste the address.
# The session policy (buildSessionPolicy) names this contract explicitly —
# a granted signer can call tap() on THIS address and nothing else.
NEXT_PUBLIC_GAME_CONTRACT_ADDRESS=


# --- Optional --------------------------------------------------------

# How long a granted session stays valid, in minutes.
# Default 15. Clamped to 1440 (24h) so a stray extra zero cannot create
# a near-permanent grant. Baked into each policy's expiry condition, so
# it is enforced by Privy, not merely by this app's own bookkeeping.
SESSION_DURATION_MINUTES=15

# RPC endpoint the backend broadcasts each tap() transaction to. SERVER ONLY.
#
# Privy's server-side eth_sendTransaction does not support chain 97741, so
# the SDK's createSessionActionRoute asks Privy to sign each tap() and
# broadcasts it to PEPU's RPC itself. Optional: without it the SDK uses the
# chain's public default RPC (rate-limited, still works). To use an
# authenticated endpoint (e.g. a Conduit URL with your key), set it here.
PEPU_RPC_URL=

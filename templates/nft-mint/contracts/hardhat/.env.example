# A dedicated development private key with minimal funds. Never a key
# holding meaningful value, and never commit the real .env file.
DEPLOYER_PRIVATE_KEY=0xyourdevelopmentprivatekey

# Base URI for token metadata (trailing slash; tokenURI() appends the
# token id). Leave empty for a quick local test — see scripts/deploy.ts.
BASE_URI=

# Mint price in wei. 0 = free mint.
MINT_PRICE=0

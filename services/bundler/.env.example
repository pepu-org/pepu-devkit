# Copy this file to .env and fill in real values. Never commit the real .env.
#
# Alto's CLI is built on yargs with `.env("ALTO")` enabled (verified in
# src/cli/alto.ts of pimlicolabs/alto @ 0.0.21 / v1.2.8), which means every
# environment variable prefixed ALTO_ is mapped automatically onto the
# matching --kebab-case-flag. That is the ONLY mechanism used here to hand
# Alto its RPC URL and private keys — they are never written into
# alto.config.json (which is committed) and never passed as CLI arguments
# (which would leak into `ps`/shell history/process-list on shared hosts).

# --- Secret: RPC endpoint (the URL itself embeds the Conduit API key as a
#     path segment, so the whole URL is a secret, not just "a config value") ---
# Format: https://rpc-pepu-v2-mainnet-0.t.conduit.xyz/<CONDUIT_API_KEY>
# Source: CONDUIT_API_KEY in ../../.env of the pepu repo root.
ALTO_RPC_URL=https://rpc-pepu-v2-mainnet-0.t.conduit.xyz/REPLACE_WITH_CONDUIT_API_KEY

# --- Secret: submitter EOA private key ---
# This is the BUNDLER_PRIVATE_KEY from ../../deploy/.keys.env (BUNDLER_ADDRESS
# 0xF585840Cb46852223B1a8ecE23EA31Ef9656e60e, funded with 50,000 PEPU at time
# of writing). Alto's `--executor-private-keys` accepts a comma-separated
# list; only one funded key exists in scope right now, so only one is set.
# Our architecture notes
# recommends 3-5 executor keys in production so a bundle in flight on one
# nonce doesn't block the next bundle -- that is a documented gap, not an
# oversight (see AGENTS.md "Known gaps").
ALTO_EXECUTOR_PRIVATE_KEYS=0xREPLACE_WITH_BUNDLER_PRIVATE_KEY

# --- Not set on purpose: ALTO_UTILITY_PRIVATE_KEY ---
# The utility wallet refills executor wallets that fall below
# --min-executor-balance. With only one executor key and no separate funded
# treasury wallet in scope, there is nothing for a utility wallet to refill
# from, so alto.config.json sets "refilling-wallets": false and this variable
# is deliberately left unset. Wire it up once a real treasury key exists.

# --- Optional overrides (defaults live in alto.config.json / Alto's own
#     defaults; uncomment only if you have a specific, evidenced reason) ---
# ALTO_LOG_LEVEL=debug

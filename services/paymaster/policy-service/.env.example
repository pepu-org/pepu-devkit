# Copy to .env and fill in. Never commit the real .env (see ../.gitignore).
#
# PAYMASTER_SIGNER_PRIVATE_KEY itself is NOT read from here — it comes from
# ../../deploy/.keys.env (repo root, gitignored, shared across services),
# loaded automatically by src/config.ts's loadEnvFiles(). This file is only
# for everything else this service needs.

# --- Privy (server-side verification only; same app as the client SDK uses) ---
# Source: PRIVY_APP_ID / PRIVY_APP_SECRET in ../../.env of the pepu repo root.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Chain / paymaster ---
# 97741 = PEPU mainnet, 97740 = PEPU testnet.
CHAIN_ID=97741
# Canonical EntryPoint v0.7 address; override only if targeting a different chain/EntryPoint.
ENTRY_POINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
# REQUIRED, no default: the deployed SingletonPaymasterV7-style contract
# address (owned by the contract engineer, services/paymaster/contracts/).
# Not yet deployed as of this writing -- see README "Known gaps".
PAYMASTER_CONTRACT_ADDRESS=

# --- HTTP ---
PORT=8787

# --- Persistence ---
# Defaults to ./data/policy.db (gitignored) if unset.
DB_PATH=

# --- Paymaster gas-limit defaults returned in every approval ---
# Tune once the deployed contract exists and can be measured against; see README.
PAYMASTER_VERIFICATION_GAS_LIMIT=100000
PAYMASTER_POST_OP_GAS_LIMIT=50000

# --- Signature validity window (seconds); bounds a leaked-but-unsubmitted signature ---
VALIDITY_WINDOW_SECONDS=90

# --- Per-user caps (keyed by Privy user_id, not wallet address) ---
USER_HOURLY_COUNT_CAP=20
USER_DAILY_COUNT_CAP=100
USER_LIFETIME_COUNT_CAP=2000
#
# SPEND CAP SIZING (learned the hard way, 2026-09-30 -- see README "Threat
# model" and the incident note in src/config.ts): size these around actual
# measured operation cost, not a round-looking number. On PEPU mainnet
# (chain 97741, base fee ~12,500 gwei), a UserOperation that deploys the
# user's Kernel smart account (factory/factoryData present -- true for
# every user's FIRST transaction) costs ~12 PEPU worst-case; every later
# UserOp from that same, already-deployed sender costs ~3 PEPU. A cap
# smaller than ~12 PEPU denies 100% of first-time users on their very
# first action -- the previous defaults here (0.1 / 1 / 10 PEPU) did
# exactly that, live, on real traffic: sender
# 0x1b75a60f670e50fc163b69c8a6e70f67ddda49e7's 11.972835 PEPU deployment
# op was denied against a 0.1 PEPU hourly cap. Keep hourly <= daily <=
# lifetime (each is a superset window of the shorter one).
USER_HOURLY_SPEND_CAP_WEI=25000000000000000000
USER_DAILY_SPEND_CAP_WEI=100000000000000000000
USER_LIFETIME_SPEND_CAP_WEI=1000000000000000000000

# --- Global circuit breaker: hard daily ceiling across the whole service ---
# Code default (src/config.ts fallback if unset) is 1000 PEPU. This
# service's real deployment sets it lower -- 500000000000000000000
# (500 PEPU/day) -- because Kernel account factories are PERMISSIONLESS
# (see src/paymasterRpcAuth.ts's doc comment): an attacker can mint
# unlimited fresh sender addresses through the ERC-7677 paymaster JSON-RPC
# endpoint, each getting its own fresh per-sender cap, and collectively
# drain the daily budget even though no single sender/app ever exceeds ITS
# OWN cap. 500 PEPU/day is roughly 40 account deployments (~12 PEPU each,
# the one-time cost of a user's first UserOp) or many more ~3 PEPU
# follow-up ops, comfortably above the per-user (100 PEPU) and per-app
# (see config/apps.json) daily caps for legitimate multi-user traffic,
# while staying at 25% of a 2,000 PEPU EntryPoint deposit -- tune this to
# your own deposit size and expected traffic, but treat "1000 PEPU" here
# as a permissive code default, not a recommendation.
GLOBAL_DAILY_SPEND_CEILING_WEI=1000000000000000000000

# --- Config files (per-app budgets/allowlist-subsets, global allowlist) ---
# Default to config/apps.json and config/allowlist.json if unset.
APPS_CONFIG_PATH=
ALLOWLIST_CONFIG_PATH=

# --- Admin ---
# Required to use POST /admin/circuit-breaker/reset. Leave unset to disable
# that endpoint entirely (the CLI script scripts/reset-circuit-breaker still
# works without it, since it doesn't go through HTTP).
ADMIN_TOKEN=

# --- Paymaster JSON-RPC (ERC-7677) -- see src/paymasterRpc.ts / paymasterRpcAuth.ts ---
# This is the surface Privy's dashboard "Paymaster URL" field talks to
# (POST /paymaster/<appToken>, where <appToken> is a raw app API key --
# same value as X-Api-Key above, just delivered via the URL path since
# Privy's paymaster field is a bare URL with no separate header/secret
# field. See README "Paymaster JSON-RPC auth trade-off" before changing
# either of these.

# Comma-separated list of exact Origin header values allowed to call
# POST /paymaster/:appToken (e.g. https://app.example.com). Leave unset
# (default) to allow ANY origin -- required for this to work at all until
# you know your production frontend's exact origin(s); narrow this once you
# do. This is a supplementary browser-side speed bump, NOT the real auth --
# see paymasterRpcAuth.ts.
PAYMASTER_RPC_ALLOWED_ORIGINS=

# true (default) sponsors UserOperations that deploy a NEW Kernel smart
# account (factory/factoryData present) through this public endpoint --
# required for a legitimate first-time user's very first transaction to be
# sponsored. Set to false to deny those specifically, which meaningfully
# raises the cost of an attacker minting many fresh sender addresses to get
# many fresh per-sender caps (see paymasterRpcAuth.ts) at the cost of
# breaking sponsored first-time onboarding through this endpoint.
PAYMASTER_RPC_ALLOW_ACCOUNT_DEPLOYMENT=true

# =====================================================================
# Tiered sponsorship v2 (OFF by default). See ../SPONSORSHIP-SPEC.md and openapi.yaml.
# With SPONSORSHIP_V2_ENABLED unset/false, none of this is read and /v2/* does not exist.
# =====================================================================
# SPONSORSHIP_V2_ENABLED=true
# SPONSORSHIP_V2_PAYMASTER_ADDRESS=0x...        # the NEW PepuSponsoredPaymasterV7 (not the v1 address)
# SPONSORSHIP_V2_RPC_URL=https://rpc-pepu-v2-mainnet-0.t.conduit.xyz/<key>   # or CONDUIT_API_KEY
# SPONSORSHIP_V2_DEPLOY_BLOCK=0
# SPONSORSHIP_SIWE_DOMAINS=dashboard.example.com          # comma-separated expected SIWE domains
# SPONSORSHIP_PUBLIC_BASE_URL=https://<host>              # used to build the paymaster URL returned to projects
# SPONSORSHIP_ADMIN_TOKEN=                                # >= 32 chars; unset disables /v2/admin
# SPONSORSHIP_API_ALLOWED_ORIGINS=https://dashboard.example.com
# TRUST_PROXY=false                                       # true behind a tunnel or reverse proxy (reads X-Forwarded-For)
# Free tier: ONLY for users with a Privy account (a verified Privy access token is required on every free-tier
# request). There is no anonymous tier and NO chain-wide daily ceiling (both removed; old env vars for them are ignored).
# FREE_TIER_PER_USER_DAILY_WEI=50000000000000000000       # 50 PEPU per Privy user per day
# FREE_TIER_PER_USER_HOURLY_WEI=30000000000000000000
# FREE_TIER_PER_USER_DAILY_COUNT=40
# FREE_TIER_PER_USER_HOURLY_COUNT=20
# PROJECT_DEFAULT_PER_USER_DAILY_WEI=200000000000000000000
# PROJECT_MAX_PER_USER_DAILY_WEI=5000000000000000000000
# SPONSORSHIP_V2_PM_VERIFICATION_GAS_LIMIT=200000        # measured validation ~64-69k on the real EntryPoint; 200k leaves headroom
# SPONSORSHIP_V2_PM_POST_OP_GAS_LIMIT=40000               # the contract minimum; EntryPoint v0.7 penalises UNUSED gas, so do not raise it
# SPONSORSHIP_V2_REQUIRE_SENDER_OWNERSHIP=true
# SPONSORSHIP_V2_VALIDITY_WINDOW_SECONDS=60               # signature validity window (code default 60)
# --- v2 gas/fee bounds enforced before signing (code defaults shown) ---
# SPONSORSHIP_V2_MAX_PRE_VERIFICATION_GAS=1000000
# SPONSORSHIP_V2_MAX_VERIFICATION_GAS_LIMIT=1500000
# SPONSORSHIP_V2_MAX_CALL_GAS_LIMIT=3000000
# SPONSORSHIP_V2_MAX_FEE_BASEFEE_MULTIPLE=3               # maxFeePerGas may be at most this multiple of the current base fee
# SPONSORSHIP_V2_MAX_PRIORITY_BASEFEE_MULTIPLE=1
# Absolute maxFeePerGas cap (code default 40000 gwei). MUST stay at or below the contract's
# DEFAULT_MAX_FEE_PER_GAS_GWEI (the on-chain cap set by the deploy script), or the service
# would sign ops the contract then rejects.
# SPONSORSHIP_V2_MAX_FEE_PER_GAS_CAP_WEI=40000000000000
# --- v2 reservation caps (bps are of the relevant daily budget; code defaults shown) ---
# SPONSORSHIP_RESERVATION_PER_SENDER_MAX_COUNT=2          # max concurrent unsettled reservations per sender
# SPONSORSHIP_RESERVATION_PER_IP_BPS=500                  # 5% of the budget per client IP
# SPONSORSHIP_RESERVATION_PER_CREDENTIAL_BPS=2500         # 25% per credential
# SPONSORSHIP_RESERVATION_MIN_OPS=2                       # floor: always allow at least this many ops' worth
# --- v2 project ownership claims (POST /v2/projects/verify) ---
# SPONSORSHIP_CLAIM_ATTESTATION_TTL_SECONDS=600           # validity of an ownership attestation the signer issues
# RATE_LIMIT_VERIFY_PER_IP_PER_MIN=10                     # each call makes one outbound Privy request with a developer's secret
# RATE_LIMIT_VERIFY_PER_APP_PER_MIN=5                     # per Privy app id: bounds secret guessing
# --- v2 rate limit ---
# RATE_LIMIT_CLIENT_TOKEN_PER_IP_PER_MIN=30               # client-token requests per IP per minute
# RATE_LIMIT_SPONSOR_PER_IP_PER_MIN=600                    # POST /v2/sponsor per IP, checked BEFORE the body is read (a single backend using a server key sends from one IP: raise it for a busy app)
# RATE_LIMIT_RPC_UNKNOWN_TOKEN_PER_IP_PER_MIN=60           # ERC-7677 requests per IP whose URL token matches no credential (junk tokens)
# --- v2 audit retention ---
# SPONSORSHIP_AUDIT_RETENTION_DAYS=30                      # the reconciler timer deletes audit_log_v2 rows older than this; 0 = keep forever. Unknown-credential denials are never written (counted in memory, see GET /v2/admin/overview)
